//| mill-version: 1.1.10
import mill.*
import mill.api.{Task, *}
import scalalib.*
import publish.*
import mill.util.Jvm

import scala.util.Try

val millVersions = Seq("1.0.0", "2.0.0-M2") // scala-steward:off
val millBinaryVersions:                     Seq[String] = millVersions.map(millBinaryVersion)
def millBinaryVersion(millVersion: String): String      =
  millVersion.split("\\.") match {
    case Array(major, minor, _*) if Try(major.toInt < 1).getOrElse(false) => s"$major.$minor"
    case Array(major, _*)                                                 => major
  }

def millVersion(binaryVersion: String): String = millVersions.find(v => millBinaryVersion(v) == binaryVersion).get

def ghOrg      = "alexarchambault"
def ghName     = "mill-native-image"
def publishOrg = "io.github.alexarchambault.mill"
trait MillNativeImagePublishModule extends SonatypeCentralPublishModule {
  def pomSettings: T[PomSettings] = PomSettings(
    description = artifactName(),
    organization = publishOrg,
    url = s"https://github.com/$ghOrg/$ghName",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("alexarchambault", "mill-native-image"),
    developers = Seq(
      Developer("alexarchambault", "Alex Archambault", "https://github.com/alexarchambault")
    ),
  )

  /** Version derived from the `v*` Git tags */
  def publishVersion: T[String] = Task.Input {
    def git(args: String*): Option[String] =
      Try(os.call(("git", args), cwd = BuildCtx.workspaceRoot, stderr = os.Pipe).out.trim())
        .toOption
        .filter(_.nonEmpty)

    // if HEAD is tagged, use that tag, else bump the patch version of the latest tag, as a snapshot
    git("describe", "--exact-match", "--tags", "--match", "v*", "HEAD")
      .map(_.stripPrefix("v"))
      .getOrElse {
        val previous = git("describe", "--abbrev=0", "--tags", "--match", "v*")
          .map(_.stripPrefix("v"))
          .getOrElse("0.0.0")
        val elems  = previous.split('.').take(3)
        val bumped = elems.init :+ (elems.last.takeWhile(_.isDigit).toInt + 1).toString
        bumped.mkString(".") + "-SNAPSHOT"
      }
  }

  /**
   * Empty javadoc JAR (only a manifest inside it) - we don't publish any API
   * documentation
   */
  override def docJar: T[PathRef] = Task {
    PathRef(Jvm.createJar(Task.dest / "out.jar", Seq(), manifest()))
  }
}

object Scala {
  def version3:      String = "3.7.4"
  def version3Mill2: String = "3.9.0"
}

object Versions {
  def osLib = "0.11.8"
  def ujson = "4.4.3"
  def sttp  = "4.0.27"
  def zio   = "2.1.26"
}

object plugin      extends Cross[PluginModule](millBinaryVersions)
trait PluginModule extends Cross.Module[String] with ScalaModule with MillNativeImagePublishModule {
  def millBinaryVersion: String    = crossValue
  def artifactName:      T[String] = s"mill-native-image_mill$millBinaryVersion"
  def scalaVersion:      T[String] =
    if millBinaryVersion == "2" then Scala.version3Mill2 else Scala.version3
  override def sourcesFolders: Seq[os.SubPath] =
    super.sourcesFolders ++ Seq(os.sub / s"src-mill$millBinaryVersion")
  def compileMvnDeps: T[Seq[Dep]] = super.compileMvnDeps() ++ Seq(
    mvn"com.lihaoyi::mill-libs-scalalib:${millVersion(millBinaryVersion)}"
  )

  object test extends ScalaTests with TestModule.ZioTest {
    // mill-libs-scalalib is compile-only in the main module (Mill provides it at runtime)
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.lihaoyi::mill-libs-scalalib:${millVersion(millBinaryVersion)}",
      mvn"com.lihaoyi::mill-testkit:${millVersion(millBinaryVersion)}",
      mvn"dev.zio::zio-test:${Versions.zio}",
      mvn"dev.zio::zio-test-sbt:${Versions.zio}",
    )
    def forkEnv = super.forkEnv() ++ Seq(
      "MILL_NATIVE_IMAGE_TEST_APP" -> `test-app`.jar().path.toString
    )
  }
}

/** Tiny application, built as a native image by the plugin tests */
object `test-app` extends JavaModule {
  // the oldest GraalVM version we test is based on Java 17
  def javacOptions = super.javacOptions() ++ Seq("--release", "17")
}

object upload      extends UploadModule
trait UploadModule extends ScalaModule with MillNativeImagePublishModule {
  override def artifactName:   T[String]   = "mill-native-image-upload"
  def scalaVersion:            T[String]   = Scala.version3
  override def compileMvnDeps: T[Seq[Dep]] =
    super.compileMvnDeps() ++ Seq(
      mvn"com.lihaoyi::os-lib:${Versions.osLib}",
      mvn"com.lihaoyi::ujson:${Versions.ujson}",
    )

  override def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ Seq(
    mvn"com.softwaremill.sttp.client4::core:${Versions.sttp}"
  )

  object test extends ScalaTests with TestModule.ZioTest {
    // os-lib and ujson are compile-only in the main module (Mill provides them at runtime)
    override def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ Seq(
      mvn"com.lihaoyi::os-lib:${Versions.osLib}",
      mvn"com.lihaoyi::ujson:${Versions.ujson}",
      mvn"dev.zio::zio-test:${Versions.zio}",
      mvn"dev.zio::zio-test-sbt:${Versions.zio}",
    )
  }
}
